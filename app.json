{
  "expo": {
    "name": "Frogress",
    "slug": "frogress",
    "scheme": "frogress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frogress.app",
      "infoPlist": {
        "NSCameraUsageDescription": "매일 기록 사진을 촬영하기 위해 카메라 접근 권한이 필요해요."
      }
    },
    "android": {
      "package": "com.frogress.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "매일 기록 사진을 촬영하기 위해 카메라 접근 권한이 필요해요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
